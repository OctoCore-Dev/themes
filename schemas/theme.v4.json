{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OctoCore Theme Manifest V4",
  "description": "Спецификация универсальной темы оформления для приложений экосистемы OctoCore",
  "type": "object",
  "required": [
    "id",
    "name",
    "author",
    "version",
    "core"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Уникальный идентификатор темы в kebab-case"
    },
    "name": {
      "type": "string",
      "description": "Человекочитаемое название темы"
    },
    "author": {
      "type": "string",
      "description": "Имя или никнейм автора / студии"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Версия темы в формате SemVer (1.0.0)"
    },
    "description": {
      "type": "string",
      "description": "Краткое описание эстетики темы"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supportedApps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "core": {
      "type": "object",
      "required": [
        "colors"
      ],
      "properties": {
        "colors": {
          "type": "object",
          "required": [
            "Primary",
            "BgBase",
            "BgSurface",
            "TextPrimary"
          ],
          "properties": {
            "BgBase": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "BgSurface": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "BgElevated": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "BgInput": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "Primary": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "PrimaryBright": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "PrimaryDim": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "Accent": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "TextPrimary": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "TextSecondary": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "TextMuted": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "SolidBorderDark": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "BorderSubtle": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "BorderMedium": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "Success": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "Warning": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "Error": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            }
          }
        },
        "gradients": {
          "type": "object"
        },
        "ui": {
          "type": "object",
          "properties": {
            "CornerRadius": {
              "type": "number"
            },
            "BlurIntensity": {
              "type": "number"
            },
            "BorderThickness": {
              "type": "number"
            },
            "CardOpacity": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "FontRegular": {
              "type": "string"
            },
            "FontMedium": {
              "type": "string"
            },
            "FontBold": {
              "type": "string"
            },
            "FontTitle": {
              "type": "string"
            },
            "FontFile": {
              "type": "string"
            }
          }
        },
        "sounds": {
          "type": "object",
          "properties": {
            "click": {
              "type": "string"
            },
            "hover": {
              "type": "string"
            },
            "notification": {
              "type": "string"
            },
            "connect": {
              "type": "string"
            },
            "disconnect": {
              "type": "string"
            },
            "ambient": {
              "type": "string"
            },
            "volume": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          }
        }
      }
    },
    "background": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "gradient"
          ]
        },
        "videoSource": {
          "type": "string"
        },
        "imageSource": {
          "type": "string"
        },
        "fallbackImage": {
          "type": "string"
        },
        "loop": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number"
        }
      }
    },
    "decorations": {
      "type": "object",
      "properties": {
        "screenFrame": {
          "type": "string",
          "description": "Путь к полноэкранной рамке для ПК (Desktop)"
        },
        "screenFrameMobile": {
          "type": "string",
          "description": "Путь к вертикальной рамке экрана для смартфонов (Mobile)"
        },
        "frameSlice": {
          "type": "object",
          "description": "Параметры 9-Slice (Nine-Patch) срезов для десктопной или универсальной рамки",
          "properties": {
            "top": { "type": "integer", "minimum": 0 },
            "right": { "type": "integer", "minimum": 0 },
            "bottom": { "type": "integer", "minimum": 0 },
            "left": { "type": "integer", "minimum": 0 }
          },
          "required": ["top", "right", "bottom", "left"]
        },
        "frameSliceMobile": {
          "type": "object",
          "description": "Параметры 9-Slice срезов для мобильной рамки",
          "properties": {
            "top": { "type": "integer", "minimum": 0 },
            "right": { "type": "integer", "minimum": 0 },
            "bottom": { "type": "integer", "minimum": 0 },
            "left": { "type": "integer", "minimum": 0 }
          },
          "required": ["top", "right", "bottom", "left"]
        },
        "cardFrame": {
          "type": "string"
        },
        "buttonRing": {
          "type": "string"
        },
        "buttonImageIdle": {
          "type": "string",
          "description": "Путь к изображению кнопки в состоянии Idle / Disconnected"
        },
        "buttonImageConnecting": {
          "type": "string",
          "description": "Путь к изображению кнопки в состоянии Connecting / Reconnecting"
        },
        "buttonImageActive": {
          "type": "string",
          "description": "Путь к изображению кнопки в состоянии Active / Connected"
        },
        "buttonImageError": {
          "type": "string",
          "description": "Путь к изображению кнопки в состоянии Error / Failed"
        },
        "buttonVideoIdle": {
          "type": "string",
          "description": "Путь к анимированному WebP/APNG с прозрачным фоном кнопки в состоянии Idle"
        },
        "buttonVideoConnecting": {
          "type": "string",
          "description": "Путь к анимированному WebP/APNG с прозрачным фоном кнопки в состоянии Connecting"
        },
        "buttonVideoActive": {
          "type": "string",
          "description": "Путь к анимированному WebP/APNG с прозрачным фоном кнопки в состоянии Active"
        },
        "buttonVideoError": {
          "type": "string",
          "description": "Путь к анимированному WebP/APNG с прозрачным фоном кнопки в состоянии Error"
        },
        "cornerStickers": {
          "type": "object"
        }
      }
    },
    "layout": {
      "type": "object"
    },
    "vfx": {
      "type": "object",
      "properties": {
        "particles": {
          "type": "string",
          "enum": [
            "none",
            "snow",
            "sakura_petals",
            "crows_feathers",
            "embers",
            "sparks",
            "neon_sparks",
            "fireflies",
            "bubbles",
            "rain",
            "twinkle",
            "matrix",
            "custom"
          ]
        },
        "particleSprite": {
          "type": "string"
        },
        "particleSprites": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string"
          }
        },
        "intensity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5.0
        },
        "size": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 4.0
        },
        "color": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "interactiveParticles": {
          "type": "boolean"
        },
        "trafficReactive": {
          "type": "boolean"
        },
        "parallaxIntensity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "screenOverlay": {
          "type": "string",
          "enum": [
            "none",
            "cyber_hud",
            "scanlines",
            "aurora",
            "crimson_vignette",
            "mystic_fog",
            "golden_rays",
            "frost_vignette"
          ]
        },
        "trafficGraphStyle": {
          "type": "string",
          "enum": [
            "neon_wave",
            "cyber_bars",
            "pulse_line",
            "aurora_ribbon"
          ]
        },
        "buttonLoaderStyle": {
          "type": "string",
          "enum": [
            "crystal",
            "reactor",
            "dual_arc",
            "runes",
            "none"
          ]
        },
        "glow": {
          "type": "object",
          "properties": {
            "intensity": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 2.0
            },
            "radius": {
              "type": "number",
              "minimum": 0.0
            },
            "coreColor": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "bloomColor": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            }
          }
        },
        "statusText": {
          "type": "object",
          "properties": {
            "disconnected": {
              "type": "string"
            },
            "connecting": {
              "type": "string"
            },
            "connected": {
              "type": "string"
            },
            "error": {
              "type": "string"
            },
            "buttonIdle": {
              "type": "string"
            },
            "buttonConnecting": {
              "type": "string"
            },
            "buttonConnected": {
              "type": "string"
            }
          }
        },
        "activeOverrides": {
          "type": "object",
          "properties": {
            "accentColor": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "glowColor": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "particleSpeedMultiplier": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5.0
            },
            "screenOverlay": {
              "type": "string",
              "enum": [
                "none",
                "cyber_hud",
                "scanlines",
                "aurora",
                "crimson_vignette",
                "mystic_fog",
                "golden_rays",
                "frost_vignette"
              ]
            }
          }
        }
      }
    },
    "typography": {
      "type": "object"
    },
    "apps": {
      "type": "object"
    },
    "customProperties": {
      "type": "object"
    }
  }
}