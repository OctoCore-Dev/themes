{
  "$schema": "../../schemas/theme.v4.json",
  "id": "sakura",
  "name": "Sakura Blossom",
  "author": "OctoCore",
  "version": "2.1.0",
  "description": "Ультра-живая тема: цветущее дерево сакуры, мягкое закатное небо, падающие лепестки, тонкая изящная рамка из цветущих ветвей и японских узелков по периметру экрана, 4 состояния неоновой кнопки сакуры (бутон, вихрь лепестков, цветущая сакура, рубиновая ошибка) и нежный звук японского колокольчика ветра",
  "tags": [
    "anime",
    "sakura",
    "flowers",
    "japanese",
    "live",
    "nature",
    "pink"
  ],
  "supportedApps": [
    "*"
  ],
  "core": {
    "colors": {
      "BgBase": "#100912",
      "BgSurface": "#1E1220",
      "BgElevated": "#2B192E",
      "BgInput": "#170D19",
      "Primary": "#FF94B8",
      "PrimaryBright": "#FFB8D0",
      "PrimaryDim": "#D45D87",
      "Accent": "#FF699E",
      "TextPrimary": "#FFF0F5",
      "TextSecondary": "#D8B4C8",
      "TextMuted": "#8F6D80",
      "SolidBorderDark": "#422038",
      "BorderSubtle": "#301729",
      "BorderMedium": "#5E2D4F",
      "Success": "#78D6A4",
      "Warning": "#FAD02C",
      "Error": "#FF6B6B"
    },
    "gradients": {
      "PrimaryGradient": {
        "angle": 45,
        "stops": [
          "#FF94B8",
          "#E65C92"
        ]
      },
      "SurfaceGradient": {
        "angle": 135,
        "stops": [
          "#261528",
          "#120814"
        ]
      }
    },
    "ui": {
      "CornerRadius": 16,
      "BlurIntensity": 25,
      "BorderThickness": 1.5,
      "CardOpacity": 0.85
    },
    "sounds": {
      "click": "assets/sounds/click.wav",
      "notification": "assets/sounds/chime.wav",
      "connect": "assets/sounds/chime.wav",
      "disconnect": "assets/sounds/chime.wav",
      "hover": "assets/sounds/hover.wav",
      "ambient": "assets/sounds/ambient.wav"
    }
  },
  "background": {
    "type": "video",
    "videoSource": "assets/bg.mp4",
    "imageSource": "assets/bg.jpg",
    "opacity": 0.45
  },
  "decorations": {
    "screenFrame": "assets/frames/branches.png",
    "frameSlice": {
      "top": 70,
      "right": 70,
      "bottom": 70,
      "left": 70
    },
    "buttonImageIdle": "assets/buttons/button_idle.png",
    "buttonImageConnecting": "assets/buttons/button_connecting.png",
    "buttonImageActive": "assets/buttons/button_active.png",
    "buttonImageError": "assets/buttons/button_error.png",
    "buttonVideoIdle": "assets/buttons/button_idle.webp",
    "buttonVideoConnecting": "assets/buttons/button_connecting.webp",
    "buttonVideoActive": "assets/buttons/button_active.webp",
    "buttonVideoError": "assets/buttons/button_error.webp",
    "screenFrameMobile": "assets/frames/frame_mobile.png",
    "frameSliceMobile": {
      "top": 90,
      "right": 60,
      "bottom": 90,
      "left": 60
    },
    "cardFrame": "assets/frames/card_frame.png",
    "cornerStickers": {
      "topLeft": "assets/stickers/corner_tl.png",
      "topRight": "assets/stickers/corner_tr.png",
      "bottomLeft": "assets/stickers/corner_bl.png",
      "bottomRight": "assets/stickers/corner_br.png"
    }
  },
  "layout": {
    "buttonPosition": "center",
    "speedWidget": "graph",
    "serverCardStyle": "glass",
    "showQuickToggles": true
  },
  "vfx": {
    "particles": "sakura_petals",
    "particleSprite": "assets/particles/petal.png",
    "intensity": 0.8,
    "speed": 1.0,
    "interactiveParticles": true,
    "trafficReactive": true,
    "parallaxIntensity": 0.35,
    "screenOverlay": "golden_rays",
    "trafficGraphStyle": "neon_wave",
    "buttonLoaderStyle": "crystal",
    "statusText": {
      "disconnected": "ВЕТЕР СТИХ",
      "connecting": "ЦВЕТЕНИЕ САКУРЫ...",
      "connected": "ПОД ЗАЩИТОЙ ЛЕПЕСТКОВ",
      "error": "ОШИБКА СВЯЗИ",
      "buttonIdle": "СТАРТ",
      "buttonConnecting": "ПОТОК",
      "buttonConnected": "ЦВЕТЕТ"
    },
    "activeOverrides": {
      "accentColor": "#F472B6",
      "glowColor": "#FB7185",
      "particleSpeedMultiplier": 1.5,
      "screenOverlay": "aurora"
    },
    "particleSprites": [
      "assets/particles/petal.png",
      "assets/particles/sakura_star.png",
      "assets/particles/blossom_orb.png"
    ],
    "glow": {
      "intensity": 1.3,
      "radius": 36,
      "coreColor": "#FF94B8",
      "bloomColor": "#FF699E"
    }
  },
  "apps": {
    "obxodka": {
      "tunnelButton": {
        "style": "glow_icon",
        "borderGlow": "#FF94B8",
        "pulseSpeed": 1.0
      },
      "sounds": {
        "connect": "assets/sounds/chime.wav",
        "disconnect": "assets/sounds/chime.wav",
        "click": "assets/sounds/click.wav"
      }
    },
    "maps": {
      "mapStyle": "sakura-night",
      "tileUrlTemplate": "https://tiles.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png",
      "markerAccent": "#FF94B8",
      "routeColor": "#FF699E"
    }
  }
}