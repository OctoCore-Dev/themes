{
  "$schema": "../../schemas/theme.v4.json",
  "id": "russia",
  "name": "Современная Россия",
  "author": "OctoCore",
  "version": "2.1.0",
  "description": "Ультрасовременная отечественная тема: ночная панорама столицы и небоскрёбов Москва-Сити, рубиновая кремлёвская звезда, 4 состояния кнопки с неоновым триколором, лаконичная 9-Slice рамка триколора, рубиновые частицы и перезвон курантов Спасской башни",
  "tags": [
    "russia",
    "modern",
    "tricolor",
    "moscow",
    "kremlin",
    "ruby",
    "star",
    "live"
  ],
  "supportedApps": [
    "*"
  ],
  "core": {
    "colors": {
      "BgBase": "#070A0F",
      "BgSurface": "#0E131C",
      "BgElevated": "#151C28",
      "BgInput": "#111822",
      "Primary": "#0066FF",
      "PrimaryBright": "#3385FF",
      "PrimaryDim": "#0044B3",
      "Accent": "#E0115F",
      "TextPrimary": "#FFFFFF",
      "TextSecondary": "#A4B3C6",
      "TextMuted": "#5E6F84",
      "SolidBorderDark": "#1C2738",
      "BorderSubtle": "#141C28",
      "BorderMedium": "#2B3D58",
      "Success": "#00D084",
      "Warning": "#FFB800",
      "Error": "#E0115F"
    },
    "gradients": {
      "PrimaryGradient": {
        "angle": 45,
        "stops": [
          "#FFFFFF",
          "#0066FF",
          "#E0115F"
        ]
      },
      "SurfaceGradient": {
        "angle": 135,
        "stops": [
          "#141C2B",
          "#080C14"
        ]
      }
    },
    "ui": {
      "CornerRadius": 14,
      "BlurIntensity": 24,
      "BorderThickness": 1.2,
      "CardOpacity": 0.86
    },
    "sounds": {
      "click": "assets/sounds/click.wav",
      "notification": "assets/sounds/click.wav"
    }
  },
  "background": {
    "type": "image",
    "imageSource": "assets/bg.jpg",
    "fallbackImage": "assets/bg.jpg",
    "opacity": 0.45
  },
  "decorations": {
    "screenFrame": "assets/frames/russia_frame.png",
    "frameSlice": {
      "top": 60,
      "right": 60,
      "bottom": 60,
      "left": 60
    },
    "buttonImageIdle": "assets/buttons/button_idle.png",
    "buttonImageConnecting": "assets/buttons/button_connecting.png",
    "buttonImageActive": "assets/buttons/button_active.png",
    "buttonImageError": "assets/buttons/button_error.png",
    "buttonVideoIdle": "assets/buttons/button_idle.webp",
    "buttonVideoConnecting": "assets/buttons/button_connecting.webp",
    "buttonVideoActive": "assets/buttons/button_active.webp",
    "buttonVideoError": "assets/buttons/button_error.webp"
  },
  "layout": {
    "buttonPosition": "center",
    "speedWidget": "graph",
    "serverCardStyle": "glass",
    "showQuickToggles": true
  },
  "vfx": {
    "particles": "custom",
    "particleSprite": "assets/particles/gold_star.png",
    "intensity": 0.6,
    "speed": 0.9,
    "size": 1.0,
    "color": "#E0115F"
  },
  "apps": {
    "obxodka": {
      "tunnelButton": {
        "style": "glow_icon",
        "borderGlow": "#0066FF",
        "pulseSpeed": 1.0
      },
      "sounds": {
        "connect": "assets/sounds/connect.wav",
        "disconnect": "assets/sounds/disconnect.wav"
      }
    }
  }
}