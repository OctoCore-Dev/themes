{
  "$schema": "../../schemas/theme.v4.json",
  "id": "russia",
  "name": "Великая Россия",
  "author": "OctoCore",
  "version": "3.0.0",
  "description": "Величественная отечественная тема в парадной красно-золотой гамме Московского Кремля: ночная Красная площадь в праздничном золотом сиянии, парящий флаг и золотой двуглавый орёл, градиентные карточки в царском рубиновом бархате с золотыми контурами, роскошная 9-Slice рамка с русской вязью, золотые угловые стикеры филиграни, 4 фазы кнопки со сменой состояний щита и частицы золотых кремлёвских звёзд",
  "tags": [
    "russia",
    "kremlin",
    "gold",
    "ruby",
    "patriotic",
    "live",
    "national",
    "official"
  ],
  "supportedApps": [
    "*"
  ],
  "core": {
    "colors": {
      "BgBase": "#0E080C",
      "BgSurface": "#1C0D15",
      "BgElevated": "#2A1421",
      "BgInput": "#150A10",
      "Primary": "#D90429",
      "PrimaryBright": "#FF2E54",
      "PrimaryDim": "#8F021A",
      "Accent": "#FFD700",
      "TextPrimary": "#FFFFFF",
      "TextSecondary": "#F5DBC8",
      "TextMuted": "#A3837D",
      "SolidBorderDark": "#28111D",
      "BorderSubtle": "#3D1B2A",
      "BorderMedium": "#FFD700",
      "Success": "#10B981",
      "Warning": "#FFB703",
      "Error": "#D90429"
    },
    "gradients": {
      "PrimaryGradient": {
        "angle": 90,
        "stops": [
          "#FFD700",
          "#FF3B5C",
          "#D90429"
        ]
      },
      "SurfaceGradient": {
        "angle": 135,
        "stops": [
          "#3E1627",
          "#230D17",
          "#13070D"
        ]
      }
    },
    "ui": {
      "CornerRadius": 16,
      "BlurIntensity": 25,
      "BorderThickness": 1.5,
      "CardOpacity": 0.88
    },
    "sounds": {
      "click": "assets/sounds/click.wav",
      "notification": "assets/sounds/click.wav",
      "connect": "assets/sounds/connect.wav",
      "disconnect": "assets/sounds/disconnect.wav"
    }
  },
  "background": {
    "type": "image",
    "imageSource": "assets/bg.jpg",
    "fallbackImage": "assets/bg.jpg",
    "opacity": 0.45
  },
  "decorations": {
    "screenFrame": "assets/frames/russia_frame.png",
    "cardFrame": "assets/frames/card_frame.png",
    "frameSlice": {
      "top": 130,
      "right": 130,
      "bottom": 130,
      "left": 130
    },
    "cornerStickers": {
      "topLeft": "assets/stickers/corner_tl.png",
      "topRight": "assets/stickers/corner_tr.png",
      "bottomLeft": "assets/stickers/corner_bl.png",
      "bottomRight": "assets/stickers/corner_br.png"
    },
    "buttonImageIdle": "assets/buttons/button_idle.png",
    "buttonImageConnecting": "assets/buttons/button_connecting.png",
    "buttonImageActive": "assets/buttons/button_active.png",
    "buttonImageError": "assets/buttons/button_error.png",
    "buttonVideoIdle": "assets/buttons/button_idle.webp",
    "buttonVideoConnecting": "assets/buttons/button_connecting.webp",
    "buttonVideoActive": "assets/buttons/button_active.webp",
    "buttonVideoError": "assets/buttons/button_error.webp"
  },
  "layout": {
    "buttonPosition": "center",
    "speedWidget": "graph",
    "serverCardStyle": "glass",
    "showQuickToggles": true
  },
  "vfx": {
    "particles": "custom",
    "particleSprite": "assets/particles/gold_star.png",
    "intensity": 0.65,
    "speed": 0.9,
    "size": 1.2,
    "color": "#FFD700"
  },
  "apps": {
    "obxodka": {
      "tunnelButton": {
        "style": "custom_image"
      },
      "sounds": {
        "connect": "assets/sounds/connect.wav",
        "disconnect": "assets/sounds/disconnect.wav"
      }
    }
  }
}