{
  "$schema": "../../schemas/theme.v4.json",
  "id": "russia",
  "name": "Великая Россия",
  "author": "OctoCore",
  "version": "2.1.0",
  "description": "Величественная отечественная тема: ночная Красная площадь и Московский Кремль в праздничной золотой подсветке, парящий триколор, золотой двуглавый орёл, градиентные карточки в благородных цветах триколора (белый отблеск, царский сапфир и рубиновый бархат), богатая 9-Slice рамка с русской золотой вязью и лентой триколора, золотые угловые стикеры филиграни, 4 фазы кнопки со сменой состояний щита и частицы золотых кремлёвских звёзд",
  "tags": [
    "russia",
    "tricolor",
    "kremlin",
    "gold",
    "patriotic",
    "live",
    "national",
    "official"
  ],
  "supportedApps": [
    "*"
  ],
  "core": {
    "colors": {
      "BgBase": "#0B1017",
      "BgSurface": "#121926",
      "BgElevated": "#1B2538",
      "BgInput": "#101622",
      "Primary": "#D90429",
      "PrimaryBright": "#FF2E54",
      "PrimaryDim": "#99031D",
      "Accent": "#FFD700",
      "TextPrimary": "#FFFFFF",
      "TextSecondary": "#D8E2ED",
      "TextMuted": "#7D8DA1",
      "SolidBorderDark": "#2A3A54",
      "BorderSubtle": "#1F2E45",
      "BorderMedium": "#D4AF37",
      "Success": "#10B981",
      "Warning": "#FFB703",
      "Error": "#D90429"
    },
    "gradients": {
      "PrimaryGradient": {
        "angle": 90,
        "stops": [
          "#FFFFFF",
          "#0039A6",
          "#D52B1E"
        ]
      },
      "SurfaceGradient": {
        "angle": 135,
        "stops": [
          "#253654",
          "#122344",
          "#381324"
        ]
      }
    },
    "ui": {
      "CornerRadius": 16,
      "BlurIntensity": 25,
      "BorderThickness": 1.5,
      "CardOpacity": 0.88
    },
    "sounds": {
      "click": "assets/sounds/click.wav",
      "notification": "assets/sounds/click.wav",
      "connect": "assets/sounds/connect.wav",
      "disconnect": "assets/sounds/disconnect.wav"
    }
  },
  "background": {
    "type": "image",
    "imageSource": "assets/bg.jpg",
    "fallbackImage": "assets/bg.jpg",
    "opacity": 0.45
  },
  "decorations": {
    "screenFrame": "assets/frames/russia_frame.png",
    "cardFrame": "assets/frames/card_frame.png",
    "frameSlice": {
      "top": 130,
      "right": 130,
      "bottom": 130,
      "left": 130
    },
    "cornerStickers": {
      "topLeft": "assets/stickers/corner_tl.png",
      "topRight": "assets/stickers/corner_tr.png",
      "bottomLeft": "assets/stickers/corner_bl.png",
      "bottomRight": "assets/stickers/corner_br.png"
    },
    "buttonImageIdle": "assets/buttons/button_idle.png",
    "buttonImageConnecting": "assets/buttons/button_connecting.png",
    "buttonImageActive": "assets/buttons/button_active.png",
    "buttonImageError": "assets/buttons/button_error.png",
    "buttonVideoIdle": "assets/buttons/button_idle.webp",
    "buttonVideoConnecting": "assets/buttons/button_connecting.webp",
    "buttonVideoActive": "assets/buttons/button_active.webp",
    "buttonVideoError": "assets/buttons/button_error.webp"
  },
  "layout": {
    "buttonPosition": "center",
    "speedWidget": "graph",
    "serverCardStyle": "glass",
    "showQuickToggles": true
  },
  "vfx": {
    "particles": "custom",
    "particleSprite": "assets/particles/gold_star.png",
    "intensity": 0.65,
    "speed": 0.9,
    "size": 1.2,
    "color": "#FFD700"
  },
  "apps": {
    "obxodka": {
      "tunnelButton": {
        "style": "custom_image"
      },
      "sounds": {
        "connect": "assets/sounds/connect.wav",
        "disconnect": "assets/sounds/disconnect.wav"
      }
    }
  }
}