{
  "$schema": "../../schemas/theme.v4.json",
  "id": "russian-winter",
  "name": "Русская Зима",
  "author": "OctoCore",
  "version": "2.1.0",
  "description": "Сказочная отечественная тема русской зимы: хрустальная морозная ночь, заснеженный русский бор и иней, серебристо-лазурная морозная палитра, 9-Slice рамка с морозными узорами на стекле, 4 фазы кнопки с ледяным кристаллом и метелью, падающие снежинки и звон морозных колокольчиков тройки",
  "tags": [
    "winter",
    "russia",
    "snow",
    "frost",
    "ice",
    "nature",
    "blue",
    "clean",
    "live"
  ],
  "supportedApps": [
    "*"
  ],
  "core": {
    "colors": {
      "BgBase": "#09111E",
      "BgSurface": "#101C2E",
      "BgElevated": "#182840",
      "BgInput": "#142236",
      "Primary": "#00B4D8",
      "PrimaryBright": "#90E0EF",
      "PrimaryDim": "#0077B6",
      "Accent": "#E0F7FA",
      "TextPrimary": "#F0F8FF",
      "TextSecondary": "#A8C5DA",
      "TextMuted": "#688299",
      "SolidBorderDark": "#1F3752",
      "BorderSubtle": "#162B42",
      "BorderMedium": "#2C4D73",
      "Success": "#06D6A0",
      "Warning": "#FFD166",
      "Error": "#EF476F"
    },
    "gradients": {
      "PrimaryGradient": {
        "angle": 45,
        "stops": [
          "#00B4D8",
          "#CAF0F8",
          "#48CAE4"
        ]
      },
      "SurfaceGradient": {
        "angle": 135,
        "stops": [
          "#152438",
          "#0B1524"
        ]
      }
    },
    "ui": {
      "CornerRadius": 16,
      "BlurIntensity": 28,
      "BorderThickness": 1.2,
      "CardOpacity": 0.8
    },
    "sounds": {
      "click": "assets/sounds/click.wav",
      "notification": "assets/sounds/click.wav",
      "connect": "assets/sounds/connect.wav",
      "disconnect": "assets/sounds/disconnect.wav",
      "hover": "assets/sounds/hover.wav",
      "ambient": "assets/sounds/ambient.wav"
    }
  },
  "background": {
    "type": "video",
    "imageSource": "assets/bg.jpg",
    "fallbackImage": "assets/bg.jpg",
    "opacity": 0.45,
    "videoSource": "assets/bg.mp4",
    "loop": true,
    "muted": true
  },
  "decorations": {
    "screenFrame": "assets/frames/winter_frame.png",
    "frameSlice": {
      "top": 80,
      "right": 80,
      "bottom": 80,
      "left": 80
    },
    "buttonImageIdle": "assets/buttons/button_idle.png",
    "buttonImageConnecting": "assets/buttons/button_connecting.png",
    "buttonImageActive": "assets/buttons/button_active.png",
    "buttonImageError": "assets/buttons/button_error.png",
    "buttonVideoIdle": "assets/buttons/button_idle.webp",
    "buttonVideoConnecting": "assets/buttons/button_connecting.webp",
    "buttonVideoActive": "assets/buttons/button_active.webp",
    "buttonVideoError": "assets/buttons/button_error.webp",
    "screenFrameMobile": "assets/frames/frame_mobile.png",
    "frameSliceMobile": {
      "top": 90,
      "right": 60,
      "bottom": 90,
      "left": 60
    },
    "cardFrame": "assets/frames/card_frame.png",
    "cornerStickers": {
      "topLeft": "assets/stickers/corner_tl.png",
      "topRight": "assets/stickers/corner_tr.png",
      "bottomLeft": "assets/stickers/corner_bl.png",
      "bottomRight": "assets/stickers/corner_br.png"
    }
  },
  "layout": {
    "buttonPosition": "center",
    "speedWidget": "graph",
    "serverCardStyle": "glass",
    "showQuickToggles": true
  },
  "vfx": {
    "particles": "snow",
    "particleSprite": "assets/particles/snowflake.png",
    "intensity": 0.7,
    "speed": 0.8,
    "size": 1.1,
    "interactiveParticles": true,
    "trafficReactive": true,
    "parallaxIntensity": 0.35,
    "screenOverlay": "frost_vignette",
    "trafficGraphStyle": "aurora_ribbon",
    "buttonLoaderStyle": "crystal",
    "statusText": {
      "disconnected": "НЕ В СЕТИ",
      "connecting": "СНЕЖНЫЙ ВИХРЬ...",
      "connected": "МОРОЗНАЯ ЗАЩИТА",
      "error": "ОШИБКА СЕТИ",
      "buttonIdle": "СТАРТ",
      "buttonConnecting": "ПУРГА",
      "buttonConnected": "В СЕТИ"
    },
    "activeOverrides": {
      "accentColor": "#60A5FA",
      "glowColor": "#93C5FD",
      "particleSpeedMultiplier": 1.6
    },
    "particleSprites": [
      "assets/particles/snowflake.png",
      "assets/particles/frost_star.png",
      "assets/particles/ice_crystal.png"
    ],
    "glow": {
      "intensity": 1.3,
      "radius": 36,
      "coreColor": "#00B4D8",
      "bloomColor": "#E0F7FA"
    }
  },
  "apps": {
    "obxodka": {
      "tunnelButton": {
        "style": "glow_icon",
        "borderGlow": "#00B4D8",
        "pulseSpeed": 1.0
      },
      "sounds": {
        "connect": "assets/sounds/connect.wav",
        "disconnect": "assets/sounds/disconnect.wav"
      }
    }
  }
}