{
  "$schema": "../../schemas/theme.v4.json",
  "id": "itachi",
  "name": "Itachi Uchiha",
  "author": "OctoCore",
  "version": "2.2.0",
  "description": "Легендарная неоново-черная аниме тема Итачи Учиха: кровавая луна, стая воронов с алым контуром чакры справа по контуру экрана, 4 состояния кнопки с эволюцией Шарингана (3 томоэ, вихрь чакры, Мангекё и черное пламя Аматерасу) и таинственный звук японского колокола",
  "tags": [
    "anime",
    "itachi",
    "naruto",
    "dark",
    "red",
    "neon",
    "sharingan",
    "live"
  ],
  "supportedApps": [
    "*"
  ],
  "core": {
    "colors": {
      "BgBase": "#0B080D",
      "BgSurface": "#16111B",
      "BgElevated": "#211929",
      "BgInput": "#120D17",
      "Primary": "#F43B57",
      "PrimaryBright": "#FF6B84",
      "PrimaryDim": "#9E0E25",
      "Accent": "#FF4766",
      "TextPrimary": "#F5F5F7",
      "TextSecondary": "#A39DAE",
      "TextMuted": "#9188A3",
      "SolidBorderDark": "#381622",
      "BorderSubtle": "#29121B",
      "BorderMedium": "#541E30",
      "Success": "#4EBA6F",
      "Warning": "#FFB703",
      "Error": "#FF4766"
    },
    "gradients": {
      "PrimaryGradient": {
        "angle": 45,
        "stops": [
          "#F43B57",
          "#FF4766"
        ]
      },
      "SurfaceGradient": {
        "angle": 135,
        "stops": [
          "#1D1424",
          "#0D0912"
        ]
      }
    },
    "ui": {
      "CornerRadius": 16,
      "BlurIntensity": 26,
      "BorderThickness": 1.5,
      "CardOpacity": 0.85
    },
    "sounds": {
      "click": "assets/sounds/click.wav",
      "notification": "assets/sounds/notification.wav",
      "connect": "assets/sounds/connect.wav",
      "disconnect": "assets/sounds/disconnect.wav",
      "hover": "assets/sounds/hover.wav",
      "ambient": "assets/sounds/ambient.wav",
      "volume": 0.85
    }
  },
  "background": {
    "type": "video",
    "videoSource": "assets/bg.mp4",
    "imageSource": "assets/bg.jpg",
    "opacity": 0.45
  },
  "decorations": {
    "screenFrame": "assets/frames/crows.png",
    "frameSlice": {
      "top": 64,
      "right": 64,
      "bottom": 64,
      "left": 64
    },
    "buttonImageIdle": "assets/buttons/button_idle.png",
    "buttonImageConnecting": "assets/buttons/button_connecting.png",
    "buttonImageActive": "assets/buttons/button_active.png",
    "buttonImageError": "assets/buttons/button_error.png",
    "buttonVideoIdle": "assets/buttons/button_idle.webp",
    "buttonVideoConnecting": "assets/buttons/button_connecting.webp",
    "buttonVideoActive": "assets/buttons/button_active.webp",
    "buttonVideoError": "assets/buttons/button_error.webp",
    "screenFrameMobile": "assets/frames/frame_mobile.png",
    "frameSliceMobile": {
      "top": 64,
      "right": 48,
      "bottom": 64,
      "left": 48
    },
    "cardFrame": "assets/frames/card_frame.png",
    "cornerStickers": {
      "topLeft": "assets/stickers/corner_tl.png",
      "topRight": "assets/stickers/corner_tr.png",
      "bottomLeft": "assets/stickers/corner_bl.png",
      "bottomRight": "assets/stickers/corner_br.png"
    },
    "buttonRing": "assets/buttons/button_ring.png"
  },
  "layout": {
    "buttonPosition": "center",
    "speedWidget": "graph",
    "serverCardStyle": "glass",
    "showQuickToggles": true
  },
  "vfx": {
    "particles": "crows_feathers",
    "particleSprite": "assets/particles/feather.png",
    "intensity": 0.7,
    "speed": 1.1,
    "interactiveParticles": true,
    "trafficReactive": true,
    "parallaxIntensity": 0.4,
    "screenOverlay": "crimson_vignette",
    "trafficGraphStyle": "pulse_line",
    "buttonLoaderStyle": "reactor",
    "statusText": {
      "disconnected": "ШАРИНГАН СКРЫТ",
      "connecting": "АКТИВАЦИЯ МАНГЕКЬЁ...",
      "connected": "ЦУКУЁМИ АКТИВНО",
      "error": "ЧАКРА ИСТОЩЕНА",
      "buttonIdle": "ГЕНДЗЮЦУ",
      "buttonConnecting": "ПЕЧАТЬ",
      "buttonConnected": "АМАТЭРАСУ"
    },
    "activeOverrides": {
      "accentColor": "#FF1E38",
      "glowColor": "#E11D48",
      "particleSpeedMultiplier": 1.7,
      "screenOverlay": "crimson_vignette"
    },
    "particleSprites": [
      "assets/particles/feather.png",
      "assets/particles/amaterasu_ember.png",
      "assets/particles/crimson_star.png"
    ],
    "glow": {
      "intensity": 1.4,
      "radius": 38,
      "coreColor": "#E61937",
      "bloomColor": "#FF1744"
    },
    "size": 1.1
  },
  "apps": {
    "obxodka": {
      "tunnelButton": {
        "style": "custom_image",
        "borderGlow": "#F43B57",
        "pulseSpeed": 1.0
      },
      "sounds": {
        "click": "assets/sounds/click.wav",
        "hover": "assets/sounds/hover.wav",
        "notification": "assets/sounds/notification.wav",
        "connect": "assets/sounds/connect.wav",
        "disconnect": "assets/sounds/disconnect.wav",
        "ambient": "assets/sounds/ambient.wav"
      }
    }
  }
}
