{
  "$schema": "../../schemas/theme.v4.json",
  "id": "itachi",
  "name": "Itachi Uchiha",
  "author": "OctoCore",
  "version": "2.0.0",
  "description": "Легендарная неоново-черная аниме тема Итачи Учиха: кровавая луна, стая воронов с алым контуром чакры справа по контуру экрана, 4 состояния кнопки с эволюцией Шарингана (3 томоэ, вихрь чакры, Мангекё и черное пламя Аматерасу) и таинственный звук японского колокола",
  "tags": [
    "anime",
    "itachi",
    "naruto",
    "dark",
    "red",
    "neon",
    "sharingan",
    "live"
  ],
  "supportedApps": [
    "*"
  ],
  "core": {
    "colors": {
      "BgBase": "#0B080D",
      "BgSurface": "#16111B",
      "BgElevated": "#211929",
      "BgInput": "#120D17",
      "Primary": "#E61937",
      "PrimaryBright": "#FF3355",
      "PrimaryDim": "#9E0E25",
      "Accent": "#FF1744",
      "TextPrimary": "#F5F5F7",
      "TextSecondary": "#A39DAE",
      "TextMuted": "#6B6478",
      "SolidBorderDark": "#381622",
      "BorderSubtle": "#29121B",
      "BorderMedium": "#541E30",
      "Success": "#4EBA6F",
      "Warning": "#FFB703",
      "Error": "#FF0033"
    },
    "gradients": {
      "PrimaryGradient": {
        "angle": 45,
        "stops": [
          "#E61937",
          "#9E0E25"
        ]
      },
      "SurfaceGradient": {
        "angle": 135,
        "stops": [
          "#1D1424",
          "#0D0912"
        ]
      }
    },
    "ui": {
      "CornerRadius": 16,
      "BlurIntensity": 25,
      "BorderThickness": 1.5,
      "CardOpacity": 0.85
    },
    "sounds": {
      "click": "assets/sounds/click.wav",
      "notification": "assets/sounds/chime.wav",
      "connect": "assets/sounds/connect.wav",
      "disconnect": "assets/sounds/chime.wav"
    }
  },
  "background": {
    "type": "video",
    "videoSource": "assets/bg.mp4",
    "imageSource": "assets/bg.jpg",
    "opacity": 0.45
  },
  "decorations": {
    "screenFrame": "assets/frames/crows.png",
    "frameSlice": {
      "top": 80,
      "right": 140,
      "bottom": 80,
      "left": 80
    },
    "buttonImageIdle": "assets/buttons/button_idle.png",
    "buttonImageConnecting": "assets/buttons/button_connecting.png",
    "buttonImageActive": "assets/buttons/button_active.png",
    "buttonImageError": "assets/buttons/button_error.png",
    "buttonVideoIdle": "assets/buttons/button_idle.webp",
    "buttonVideoConnecting": "assets/buttons/button_connecting.webp",
    "buttonVideoActive": "assets/buttons/button_active.webp",
    "buttonVideoError": "assets/buttons/button_error.webp"
  },
  "layout": {
    "buttonPosition": "center",
    "speedWidget": "graph",
    "serverCardStyle": "glass",
    "showQuickToggles": true
  },
  "vfx": {
    "particles": "crows_feathers",
    "particleSprite": "assets/particles/feather.png",
    "intensity": 0.7,
    "speed": 1.1,
    "interactiveParticles": true,
    "trafficReactive": true,
    "parallaxIntensity": 0.4,
    "screenOverlay": "crimson_vignette",
    "trafficGraphStyle": "pulse_line",
    "buttonLoaderStyle": "reactor",
    "statusText": {
      "disconnected": "ШАРИНГАН СКРЫТ",
      "connecting": "АКТИВАЦИЯ МАНГЕКЬЁ...",
      "connected": "ЦУКУЁМИ АКТИВНО",
      "error": "ЧАКРА ИСТОЩЕНА",
      "buttonIdle": "ГЕНДЗЮЦУ",
      "buttonConnecting": "ПЕЧАТЬ",
      "buttonConnected": "АМАТЭРАСУ"
    },
    "activeOverrides": {
      "accentColor": "#FF1E38",
      "glowColor": "#E11D48",
      "particleSpeedMultiplier": 1.7
    }
  },
  "apps": {
    "obxodka": {
      "tunnelButton": {
        "style": "glow_icon",
        "borderGlow": "#E61937",
        "pulseSpeed": 1.0
      },
      "sounds": {
        "connect": "assets/sounds/connect.wav",
        "disconnect": "assets/sounds/chime.wav",
        "click": "assets/sounds/click.wav"
      }
    },
    "maps": {
      "mapStyle": "itachi-dark",
      "tileUrlTemplate": "https://tiles.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png",
      "markerAccent": "#E61937",
      "routeColor": "#FF1744"
    }
  }
}