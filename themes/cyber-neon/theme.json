{
  "$schema": "../../schemas/theme.v4.json",
  "id": "cyber-neon",
  "name": "Cyber Neon 2077",
  "author": "OctoCore",
  "version": "2.2.0",
  "description": "Футуристическая неоновая тема: киберпанк-ночь, электро-бирюзовый и неоново-пурпурный контраст, светящееся ядро реактора и искры кибернетической энергии",
  "tags": [
    "cyberpunk",
    "neon",
    "synthwave",
    "dark",
    "cyan",
    "magenta",
    "live"
  ],
  "supportedApps": [
    "*"
  ],
  "core": {
    "colors": {
      "BgBase": "#0A0915",
      "BgSurface": "#131126",
      "BgElevated": "#1C1836",
      "BgInput": "#18142E",
      "Primary": "#00F0FF",
      "PrimaryBright": "#5CFFFF",
      "PrimaryDim": "#00A3B5",
      "Accent": "#FF2E7A",
      "TextPrimary": "#F0F4FF",
      "TextSecondary": "#96A1C4",
      "TextMuted": "#7D8BB3",
      "SolidBorderDark": "#2A224D",
      "BorderSubtle": "#1E1838",
      "BorderMedium": "#392F66",
      "Success": "#00FF9D",
      "Warning": "#FFB800",
      "Error": "#FF3D6E"
    },
    "gradients": {
      "PrimaryGradient": {
        "angle": 45,
        "stops": [
          "#00F0FF",
          "#FF2E7A"
        ]
      },
      "SurfaceGradient": {
        "angle": 135,
        "stops": [
          "#1C1636",
          "#0D0A1C"
        ]
      }
    },
    "ui": {
      "CornerRadius": 16,
      "BlurIntensity": 26,
      "BorderThickness": 1.5,
      "CardOpacity": 0.85
    },
    "sounds": {
      "click": "assets/sounds/click.wav",
      "notification": "assets/sounds/notification.wav",
      "connect": "assets/sounds/connect.wav",
      "disconnect": "assets/sounds/disconnect.wav",
      "hover": "assets/sounds/hover.wav",
      "ambient": "assets/sounds/ambient.wav",
      "volume": 0.85
    }
  },
  "background": {
    "type": "video",
    "videoSource": "assets/bg.mp4",
    "imageSource": "assets/bg.jpg",
    "opacity": 0.45
  },
  "decorations": {
    "screenFrame": "assets/frames/cyber_frame.png",
    "frameSlice": {
      "top": 64,
      "right": 64,
      "bottom": 64,
      "left": 64
    },
    "buttonImageIdle": "assets/buttons/btn_idle.png",
    "buttonImageConnecting": "assets/buttons/btn_connecting.png",
    "buttonImageActive": "assets/buttons/btn_active.png",
    "buttonImageError": "assets/buttons/btn_error.png",
    "buttonVideoIdle": "assets/buttons/button_idle.webp",
    "buttonVideoConnecting": "assets/buttons/button_connecting.webp",
    "buttonVideoActive": "assets/buttons/button_active.webp",
    "buttonVideoError": "assets/buttons/button_error.webp",
    "screenFrameMobile": "assets/frames/frame_mobile.png",
    "frameSliceMobile": {
      "top": 64,
      "right": 48,
      "bottom": 64,
      "left": 48
    },
    "cardFrame": "assets/frames/card_frame.png",
    "cornerStickers": {
      "topLeft": "assets/stickers/corner_tl.png",
      "topRight": "assets/stickers/corner_tr.png",
      "bottomLeft": "assets/stickers/corner_bl.png",
      "bottomRight": "assets/stickers/corner_br.png"
    },
    "buttonRing": "assets/buttons/button_ring.png"
  },
  "layout": {
    "buttonPosition": "center",
    "speedWidget": "graph",
    "serverCardStyle": "glass",
    "showQuickToggles": true
  },
  "vfx": {
    "particles": "neon_sparks",
    "particleSprite": "assets/particles/cyber_spark.png",
    "intensity": 0.75,
    "speed": 1.2,
    "interactiveParticles": true,
    "trafficReactive": true,
    "parallaxIntensity": 0.45,
    "screenOverlay": "cyber_hud",
    "trafficGraphStyle": "cyber_bars",
    "buttonLoaderStyle": "dual_arc",
    "statusText": {
      "disconnected": "NETRUN: OFFLINE",
      "connecting": "BYPASSING ICE...",
      "connected": "NEURAL LINK ACTIVE",
      "error": "ICE BREACH FAILED",
      "buttonIdle": "JACK IN",
      "buttonConnecting": "SYNC",
      "buttonConnected": "ONLINE"
    },
    "activeOverrides": {
      "accentColor": "#00F0FF",
      "glowColor": "#FF0055",
      "particleSpeedMultiplier": 1.8,
      "screenOverlay": "cyber_hud"
    },
    "particleSprites": [
      "assets/particles/cyber_spark.png",
      "assets/particles/magenta_shard.png",
      "assets/particles/data_hex.png"
    ],
    "glow": {
      "intensity": 1.35,
      "radius": 36,
      "coreColor": "#00F0FF",
      "bloomColor": "#FF0055"
    },
    "size": 1.1
  },
  "apps": {
    "obxodka": {
      "tunnelButton": {
        "style": "custom_image",
        "borderGlow": "#00F0FF",
        "pulseSpeed": 1.2
      },
      "sounds": {
        "click": "assets/sounds/click.wav",
        "hover": "assets/sounds/hover.wav",
        "notification": "assets/sounds/notification.wav",
        "connect": "assets/sounds/connect.wav",
        "disconnect": "assets/sounds/disconnect.wav",
        "ambient": "assets/sounds/ambient.wav"
      }
    }
  }
}
