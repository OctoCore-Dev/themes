{
  "$schema": "../../schemas/theme.v4.json",
  "id": "synthwave-retrowave",
  "name": "Sunset Retrowave 84",
  "author": "OctoCore",
  "version": "1.0.0",
  "description": "Яркая атмосфера ретрофутуризма и Outrun 80-х: закатное неоновое солнце над лазерной сеткой шоссе, горячий пурпурно-бирюзовый контраст, аркадная CRT-рамка, турбо-ядро на кнопке VPN и аналоговые синтезаторные аккорды",
  "tags": [
    "synthwave",
    "retrowave",
    "outrun",
    "80s",
    "neon",
    "sunset",
    "cyber",
    "live"
  ],
  "supportedApps": [
    "*"
  ],
  "core": {
    "colors": {
      "BgBase": "#0B0518",
      "BgSurface": "#160B2E",
      "BgElevated": "#241247",
      "BgInput": "#110824",
      "Primary": "#FF007F",
      "PrimaryBright": "#FF55A3",
      "PrimaryDim": "#B8005C",
      "Accent": "#00F0FF",
      "TextPrimary": "#FFF0FA",
      "TextSecondary": "#C4A3E0",
      "TextMuted": "#7A5C99",
      "SolidBorderDark": "#38145C",
      "BorderSubtle": "#290F45",
      "BorderMedium": "#FF007F",
      "Success": "#00F0FF",
      "Warning": "#FF9E00",
      "Error": "#FF1744"
    },
    "gradients": {
      "PrimaryGradient": {
        "angle": 45,
        "stops": [
          "#FF007F",
          "#FF6B00",
          "#00F0FF"
        ]
      },
      "SurfaceGradient": {
        "angle": 135,
        "stops": [
          "#26104A",
          "#0D051C"
        ]
      }
    },
    "ui": {
      "CornerRadius": 16,
      "BlurIntensity": 26,
      "BorderThickness": 1.5,
      "CardOpacity": 0.84
    },
    "sounds": {
      "click": "assets/sounds/click.wav",
      "hover": "assets/sounds/hover.wav",
      "notification": "assets/sounds/notification.wav",
      "connect": "assets/sounds/connect.wav",
      "disconnect": "assets/sounds/disconnect.wav",
      "ambient": "assets/sounds/ambient.wav"
    }
  },
  "background": {
    "type": "video",
    "videoSource": "assets/bg.mp4",
    "imageSource": "assets/bg.jpg",
    "fallbackImage": "assets/bg.jpg",
    "loop": true,
    "muted": true,
    "opacity": 0.45
  },
  "decorations": {
    "screenFrame": "assets/frames/frame.png",
    "screenFrameMobile": "assets/frames/frame_mobile.png",
    "cardFrame": "assets/frames/card_frame.png",
    "frameSlice": {
      "top": 80,
      "right": 80,
      "bottom": 80,
      "left": 80
    },
    "frameSliceMobile": {
      "top": 90,
      "right": 60,
      "bottom": 90,
      "left": 60
    },
    "cornerStickers": {
      "topLeft": "assets/stickers/corner_tl.png",
      "topRight": "assets/stickers/corner_tr.png",
      "bottomLeft": "assets/stickers/corner_bl.png",
      "bottomRight": "assets/stickers/corner_br.png"
    },
    "buttonImageIdle": "assets/buttons/button_idle.png",
    "buttonImageConnecting": "assets/buttons/button_connecting.png",
    "buttonImageActive": "assets/buttons/button_active.png",
    "buttonImageError": "assets/buttons/button_error.png",
    "buttonVideoIdle": "assets/buttons/button_idle.webp",
    "buttonVideoConnecting": "assets/buttons/button_connecting.webp",
    "buttonVideoActive": "assets/buttons/button_active.webp",
    "buttonVideoError": "assets/buttons/button_error.webp"
  },
  "layout": {
    "buttonPosition": "center",
    "speedWidget": "graph",
    "serverCardStyle": "glass",
    "showQuickToggles": true
  },
  "vfx": {
    "particles": "neon_sparks",
    "particleSprite": "assets/particles/retro_star.png",
    "particleSprites": [
      "assets/particles/retro_star.png",
      "assets/particles/laser_diamond.png",
      "assets/particles/sunset_flare.png"
    ],
    "intensity": 0.78,
    "speed": 1.15,
    "size": 1.15,
    "interactiveParticles": true,
    "trafficReactive": true,
    "parallaxIntensity": 0.4,
    "screenOverlay": "scanlines",
    "trafficGraphStyle": "cyber_bars",
    "buttonLoaderStyle": "dual_arc",
    "glow": {
      "intensity": 1.35,
      "radius": 38,
      "coreColor": "#FF007F",
      "bloomColor": "#00F0FF"
    },
    "statusText": {
      "disconnected": "TURBO DRIVE: OFF",
      "connecting": "IGNITING OUTRUN GRID...",
      "connected": "HYPERDRIVE 1984 ACTIVE",
      "error": "ENGINE OVERHEAT",
      "buttonIdle": "DRIVE",
      "buttonConnecting": "TURBO",
      "buttonConnected": "88 MPH"
    },
    "activeOverrides": {
      "accentColor": "#00F0FF",
      "glowColor": "#FF007F",
      "particleSpeedMultiplier": 1.7,
      "screenOverlay": "cyber_hud"
    }
  },
  "apps": {
    "obxodka": {
      "tunnelButton": {
        "style": "custom_image",
        "borderGlow": "#FF007F",
        "pulseSpeed": 1.1
      },
      "sounds": {
        "click": "assets/sounds/click.wav",
        "hover": "assets/sounds/hover.wav",
        "notification": "assets/sounds/notification.wav",
        "connect": "assets/sounds/connect.wav",
        "disconnect": "assets/sounds/disconnect.wav",
        "ambient": "assets/sounds/ambient.wav"
      }
    }
  }
}